# Copy to watcher/.env (ignored by git) or export in your shell. The scripts load watcher/.env.
# Paths and URLs only. Private keys stay in their own files outside the repo.

# Monad testnet, chain 10143. The e2e script ignores this and runs its own anvil.
RPC_URL=https://testnet-rpc.monad.xyz

# Written by `pnpm --filter @spillway/watcher deployment <forge broadcast file>`.
DEPLOYMENT=deployments/monad-testnet.json

# File holding the runner key as DEPLOYER_PK=0x... (or RUNNER_PK=0x...). The deploy script
# makes the deployer the adapter's runner unless RUNNER was set.
RUNNER_KEY_FILE=~/.secrets/spillway-deployer.env

# File holding the keeper key as KEEPER_PK=0x... (DEPLOYER_PK also works). settle() is open to
# anyone, so any funded account will do. Use a different account from the runner: the two run
# as separate processes and would race for the same nonce.
KEEPER_KEY_FILE=~/.secrets/spillway-keeper.env
